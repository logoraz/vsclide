    "breakpoints": [
      {
        "language": "commonlisp"
      }
    ],
    "colors": [
      {
        "id": "vsclide.stickerPlaced",
        "description": "Outline of a sticker not yet armed.",
        "defaults": {
          "dark": "#9da5b4",
          "light": "#6b7280",
          "highContrast": "#ffffff",
          "highContrastLight": "#ffffff"
        }
      },
      {
        "id": "vsclide.stickerArmed",
        "description": "Background of an armed sticker that has not run.",
        "defaults": {
          "dark": "#4f8cff33",
          "light": "#2563eb26",
          "highContrast": "#4f8cff66",
          "highContrastLight": "#4f8cff66"
        }
      },
      {
        "id": "vsclide.stickerRecorded",
        "description": "Background of a sticker that has recorded values.",
        "defaults": {
          "dark": "#3fb95033",
          "light": "#16a34a2e",
          "highContrast": "#3fb95066",
          "highContrastLight": "#3fb95066"
        }
      },
      {
        "id": "vsclide.stickerExited",
        "description": "Background of a sticker whose form exited non-locally.",
