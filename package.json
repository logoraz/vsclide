{
  "name": "vsclide",
  "displayName": ":VSCLIDE",
  "description": "A full-powered Common Lisp IDE for VS Code.",
  "version": "0.0.9",
  "publisher": "logoraz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/logoraz/vsclide.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "common lisp",
    "lisp",
    "sbcl",
    "egcl",
    "slynk",
    "repl"
  ],
  "icon": "data/graphics/lisp-icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "commonlisp",
        "aliases": [
          "Common Lisp"
        ],
        "extensions": [
          ".lisp",
          ".sexp",
          ".asd",
          ".lsp",
          ".cl"
        ],
        "configuration": "./data/syntax/language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "vsclide.connect",
        "title": "VSCLIDE: Connect"
      },
      {
        "command": "vsclide.disconnect",
        "title": "VSCLIDE: Disconnect and Stop Lisp"
      },
      {
        "command": "vsclide.restart",
        "title": "VSCLIDE: Restart Lisp"
      },
      {
        "command": "vsclide.evalTopLevelForm",
        "title": "VSCLIDE: Evaluate Top-Level Form"
      },
      {
        "command": "vsclide.evalLastExpression",
        "title": "VSCLIDE: Evaluate Last Expression"
      },
      {
        "command": "vsclide.evalSelection",
        "title": "VSCLIDE: Evaluate Selection"
      },
      {
        "command": "vsclide.compileTopLevelForm",
        "title": "VSCLIDE: Compile Top-Level Form"
      },
      {
        "command": "vsclide.compileFile",
        "title": "VSCLIDE: Compile and Load File"
      },
      {
        "command": "vsclide.clearNotes",
        "title": "VSCLIDE: Clear Compiler Notes"
      },
      {
        "command": "vsclide.showOutput",
        "title": "VSCLIDE: Show Output"
      },
      {
        "command": "vsclide.openRepl",
        "title": "VSCLIDE: Open mREPL"
      },
      {
        "command": "vsclide.newRepl",
        "title": "VSCLIDE: New mREPL",
        "icon": "$(add)"
      },
      {
        "command": "vsclide.closeRepl",
        "title": "VSCLIDE: Close mREPL",
        "icon": "$(trash)"
      },
      {
        "command": "vsclide.clearRepl",
        "title": "VSCLIDE: Clear mREPL",
        "icon": "$(clear-all)"
      },
      {
        "command": "vsclide.showDebugger",
        "title": "VSCLIDE: Show Debugger"
      },
      {
        "command": "vsclide.showInspector",
        "title": "VSCLIDE: Show Inspector"
      },
      {
        "command": "vsclide.inspect",
        "title": "VSCLIDE: Inspect Expression"
      },
      {
        "command": "vsclide.debugContinue",
        "title": "VSCLIDE: Debugger Continue"
      },
      {
        "command": "vsclide.debugAbort",
        "title": "VSCLIDE: Debugger Abort"
      },
      {
        "command": "vsclide.debugQuit",
        "title": "VSCLIDE: Debugger Quit"
      },
      {
        "command": "vsclide.debugStepInto",
        "title": "VSCLIDE: Debugger Step Into"
      },
      {
        "command": "vsclide.debugStepNext",
        "title": "VSCLIDE: Debugger Step Next"
      },
      {
        "command": "vsclide.debugStepOut",
        "title": "VSCLIDE: Debugger Step Out"
      },
      {
        "command": "vsclide.toggleBreakOnSignals",
        "title": "VSCLIDE: Toggle Break on Signals"
      },
      {
        "command": "vsclide.sticker",
        "title": "VSCLIDE: Place or Remove Sticker"
      },
      {
        "command": "vsclide.stickerClearForm",
        "title": "VSCLIDE: Clear Stickers in Form"
      },
      {
        "command": "vsclide.stickerClearFile",
        "title": "VSCLIDE: Clear Stickers in File"
      },
      {
        "command": "vsclide.stickerReplay",
        "title": "VSCLIDE: Replay Sticker Recordings"
      },
      {
        "command": "vsclide.stickerFetch",
        "title": "VSCLIDE: Fetch Sticker Recordings"
      },
      {
        "command": "vsclide.stickerForget",
        "title": "VSCLIDE: Forget Sticker Recordings"
      },
      {
        "command": "vsclide.stickerToggleBreak",
        "title": "VSCLIDE: Toggle Break on Stickers"
      },
      {
        "command": "vsclide.stickerInspect",
        "title": "VSCLIDE: Inspect Sticker Recording"
      }
    ],
    "configuration": {
      "title": "VSCLIDE",
      "properties": {
        "vsclide.keymap": {
          "type": "string",
          "enum": [
            "auto",
            "vscode",
            "emacs"
          ],
          "default": "auto",
          "enumDescriptions": [
            "The Emacs set when Awesome Emacs Keymap (tuttieee.emacs-mcx) is installed and enabled, otherwise the VS Code set.",
            "VS Code style: Alt+Enter, Ctrl+Enter, F5 and F10/F11 in the debugger, and a Ctrl+Alt+C prefix for the rest.",
            "Emacs and SLY style: C-M-x, C-x C-e, C-c C-c, C-c C-k, C-c C-s and C-c C-d chords, as with Awesome Emacs Keymap."
          ],
          "markdownDescription": "The set of key bindings for Common Lisp files and the debugger. Both are always installed; this picks which one is active. `auto` follows Awesome Emacs Keymap."
        },
        "vsclide.lisp.command": {
          "type": "string",
          "default": "sbcl",
          "description": "Lisp implementation executable that runs clide and slynk."
        },
        "vsclide.ocicl.command": {
          "type": "string",
          "default": "ocicl",
          "description": "ocicl executable that installs the Lisp dependencies of clide, once, on first use."
        },
        "vsclide.repl.openOnConnect": {
          "type": "boolean",
          "default": false,
          "description": "Open an mREPL, without taking focus, when the Lisp connects."
        },
        "vsclide.repl.sylvester": {
          "type": "boolean",
          "default": true,
          "description": "Show Sylvester's art in a new mREPL."
        },
        "vsclide.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Complete symbols in Common Lisp files."
        },
        "vsclide.completion.mode": {
          "type": "string",
          "enum": [
            "slynk",
            "document"
          ],
          "default": "slynk",
          "description": "slynk: symbols from the Lisp. document: words of the file, no Lisp needed."
        },
        "vsclide.completion.limit": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 1000,
          "description": "Most completions to offer."
        },
        "vsclide.completion.documentation": {
          "type": "boolean",
          "default": true,
          "description": "Show arglist and docstring beside the highlighted completion."
        },
        "vsclide.definitions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Go to definition (F12, Ctrl+click) from what the Lisp has loaded."
        },
        "vsclide.references.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Find All References (Shift+F12) from what the Lisp has loaded, of the kinds in vsclide.references.kinds."
        },
        "vsclide.references.kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["calls", "macroexpands", "binds", "references", "sets", "specializes"],
            "enumDescriptions": [
              "Functions that call it.",
              "Code that expands it, for a macro.",
              "Code that binds it, for a special variable.",
              "Code that reads it, for a variable.",
              "Code that sets it, for a variable.",
              "Methods that specialize on it, for a class."
            ]
          },
          "uniqueItems": true,
          "default": ["calls", "macroexpands", "binds", "references", "sets", "specializes"],
          "description": "The kinds of reference Find All References searches, as SLY's sly-edit-uses does by default. An empty list searches them all."
        },
        "vsclide.repl.syncPackage": {
          "type": "boolean",
          "default": true,
          "description": "When evaluating or compiling from the editor, switch the active mREPL to the package of the file."
        },
        "vsclide.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show compiler notes as squiggles and in the Problems panel."
        },
        "vsclide.diagnostics.minimumSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "information",
          "description": "Least serious compiler note to show."
        },
        "vsclide.signatureHelp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the lambda list of the operator being called, with the current parameter highlighted."
        },
        "vsclide.signatureHelp.documentation": {
          "type": "boolean",
          "default": true,
          "description": "Show the docstring of the operator under its lambda list."
        },
        "vsclide.stickers.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Fetch what stickers recorded after code runs, so the stickers show it."
        }
      }
    },
    "keybindings": [
      {
        "command": "vsclide.evalTopLevelForm",
        "key": "alt+enter",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.evalLastExpression",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId == commonlisp && !editorHasSelection && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.evalSelection",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId == commonlisp && editorHasSelection && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.compileTopLevelForm",
        "key": "ctrl+alt+c c",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.compileFile",
        "key": "ctrl+alt+c enter",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.openRepl",
        "key": "ctrl+alt+c r",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.inspect",
        "key": "ctrl+alt+c i",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.sticker",
        "key": "ctrl+alt+c s",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.stickerReplay",
        "key": "ctrl+alt+c p",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.stickerToggleBreak",
        "key": "ctrl+alt+c b",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.stickerFetch",
        "key": "ctrl+alt+c f",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.stickerClearForm",
        "key": "ctrl+alt+c k",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.stickerClearFile",
        "key": "ctrl+alt+c shift+k",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.showDebugger",
        "key": "ctrl+alt+c d",
        "when": "vsclide.debugging && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.debugContinue",
        "key": "f5",
        "when": "vsclide.debugging && !inDebugMode && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.debugAbort",
        "key": "shift+f5",
        "when": "vsclide.debugging && !inDebugMode && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.debugStepInto",
        "key": "f11",
        "when": "vsclide.debugging && !inDebugMode && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.debugStepNext",
        "key": "f10",
        "when": "vsclide.debugging && !inDebugMode && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.debugStepOut",
        "key": "shift+f11",
        "when": "vsclide.debugging && !inDebugMode && vsclide.activeKeymap == 'vscode'"
      },
      {
        "command": "vsclide.evalTopLevelForm",
        "key": "ctrl+alt+x",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.evalLastExpression",
        "key": "ctrl+x ctrl+e",
        "when": "editorTextFocus && editorLangId == commonlisp && !editorHasSelection && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.evalSelection",
        "key": "ctrl+c ctrl+r",
        "when": "editorTextFocus && editorLangId == commonlisp && editorHasSelection && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.compileTopLevelForm",
        "key": "ctrl+c ctrl+c",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.compileFile",
        "key": "ctrl+c ctrl+k",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.openRepl",
        "key": "ctrl+c ctrl+z",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.inspect",
        "key": "ctrl+c shift+i",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "editor.action.triggerSuggest",
        "key": "ctrl+alt+i",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.sticker",
        "key": "ctrl+c ctrl+s ctrl+s",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.stickerReplay",
        "key": "ctrl+c ctrl+s ctrl+r",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.stickerToggleBreak",
        "key": "ctrl+c ctrl+s ctrl+b",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.stickerFetch",
        "key": "ctrl+c ctrl+s ctrl+f",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.stickerClearForm",
        "key": "ctrl+c ctrl+s ctrl+k",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.stickerClearFile",
        "key": "ctrl+c ctrl+s ctrl+shift+k",
        "when": "editorTextFocus && editorLangId == commonlisp && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.showDebugger",
        "key": "ctrl+c ctrl+d d",
        "when": "vsclide.debugging && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.debugContinue",
        "key": "ctrl+c ctrl+d c",
        "when": "vsclide.debugging && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.debugAbort",
        "key": "ctrl+c ctrl+d a",
        "when": "vsclide.debugging && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.debugStepInto",
        "key": "ctrl+c ctrl+d s",
        "when": "vsclide.debugging && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.debugStepNext",
        "key": "ctrl+c ctrl+d n",
        "when": "vsclide.debugging && vsclide.activeKeymap == 'emacs'"
      },
      {
        "command": "vsclide.debugStepOut",
        "key": "ctrl+c ctrl+d o",
        "when": "vsclide.debugging && vsclide.activeKeymap == 'emacs'"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vsclide.evalTopLevelForm",
          "when": "editorLangId == commonlisp",
          "group": "vsclide@1"
        },
        {
          "command": "vsclide.evalSelection",
          "when": "editorLangId == commonlisp && editorHasSelection",
          "group": "vsclide@2"
        },
        {
          "command": "vsclide.inspect",
          "when": "editorLangId == commonlisp",
          "group": "vsclide@3"
        },
        {
          "command": "vsclide.sticker",
          "when": "editorLangId == commonlisp",
          "group": "vsclide@4"
        }
      ],
      "view/title": [
        {
          "command": "vsclide.newRepl",
          "when": "view == vsclide.mrepl",
          "group": "navigation@1"
        },
        {
          "command": "vsclide.clearRepl",
          "when": "view == vsclide.mrepl",
          "group": "navigation@2"
        },
        {
          "command": "vsclide.closeRepl",
          "when": "view == vsclide.mrepl",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "vsclide-panel",
          "title": "mREPL",
          "icon": "data/graphics/lisp-icon-sm.svg"
        }
      ]
    },
    "views": {
      "vsclide-panel": [
        {
          "type": "webview",
          "id": "vsclide.mrepl",
          "name": "mREPL"
        }
      ]
    },
    "grammars": [
      {
        "language": "commonlisp",
        "scopeName": "source.commonlisp",
        "path": "./data/syntax/commonlisp.tmLanguage.json"
      }
    ],
