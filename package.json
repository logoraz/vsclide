{
  "name": "vsclide",
  "displayName": ":VSCLIDE",
  "description": "A full-powered Common Lisp IDE for VS Code.",
  "version": "0.0.5",
  "publisher": "locutus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/logoraz/vsclide.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "common lisp",
    "lisp",
    "sbcl",
    "egcl",
    "slynk",
    "repl"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:commonlisp",
    "onView:vsclide.mrepl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "commonlisp",
        "aliases": [
          "Common Lisp"
        ],
        "extensions": [
          ".lisp",
          ".sexp",
          ".asd",
          ".lsp",
          ".cl"
        ],
        "configuration": "./data/syntax/language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "vsclide.connect",
        "title": "VSCLIDE: Connect"
      },
      {
        "command": "vsclide.disconnect",
        "title": "VSCLIDE: Disconnect and Stop Lisp"
      },
      {
        "command": "vsclide.restart",
        "title": "VSCLIDE: Restart Lisp"
      },
      {
        "command": "vsclide.evalTopLevelForm",
        "title": "VSCLIDE: Evaluate Top-Level Form"
      },
      {
        "command": "vsclide.evalLastExpression",
        "title": "VSCLIDE: Evaluate Last Expression"
      },
      {
        "command": "vsclide.evalSelection",
        "title": "VSCLIDE: Evaluate Selection"
      },
      {
        "command": "vsclide.showOutput",
        "title": "VSCLIDE: Show Output"
      },
      {
        "command": "vsclide.openRepl",
        "title": "VSCLIDE: Open mREPL"
      },
      {
        "command": "vsclide.newRepl",
        "title": "VSCLIDE: New mREPL",
        "icon": "$(add)"
      },
      {
        "command": "vsclide.closeRepl",
        "title": "VSCLIDE: Close mREPL",
        "icon": "$(trash)"
      },
      {
        "command": "vsclide.clearRepl",
        "title": "VSCLIDE: Clear mREPL",
        "icon": "$(clear-all)"
      },
      {
        "command": "vsclide.showDebugger",
        "title": "VSCLIDE: Show Debugger"
      },
      {
        "command": "vsclide.showInspector",
        "title": "VSCLIDE: Show Inspector"
      },
      {
        "command": "vsclide.inspect",
        "title": "VSCLIDE: Inspect Expression"
      },
      {
        "command": "vsclide.debugContinue",
        "title": "VSCLIDE: Debugger Continue"
      },
      {
        "command": "vsclide.debugAbort",
        "title": "VSCLIDE: Debugger Abort"
      },
      {
        "command": "vsclide.debugQuit",
        "title": "VSCLIDE: Debugger Quit"
      },
      {
        "command": "vsclide.debugStepInto",
        "title": "VSCLIDE: Debugger Step Into"
      },
      {
        "command": "vsclide.debugStepNext",
        "title": "VSCLIDE: Debugger Step Next"
      },
      {
        "command": "vsclide.debugStepOut",
        "title": "VSCLIDE: Debugger Step Out"
      },
      {
        "command": "vsclide.toggleBreakOnSignals",
        "title": "VSCLIDE: Toggle Break on Signals"
      }
    ],
    "configuration": {
      "title": "VSCLIDE",
      "properties": {
        "vsclide.lisp.command": {
          "type": "string",
          "default": "sbcl",
          "description": "Lisp implementation executable that runs clide and slynk."
        },
        "vsclide.repl.openOnConnect": {
          "type": "boolean",
          "default": false,
          "description": "Open an mREPL, without taking focus, when the Lisp connects."
        },
        "vsclide.repl.sylvester": {
          "type": "boolean",
          "default": true,
          "description": "Show Sylvester's art in a new mREPL."
        }
      }
    },
    "keybindings": [
      {
        "command": "vsclide.evalTopLevelForm",
        "key": "ctrl+alt+x",
        "when": "editorLangId == commonlisp"
      },
      {
        "command": "vsclide.evalLastExpression",
        "key": "ctrl+alt+e",
        "when": "editorLangId == commonlisp"
      },
      {
        "command": "vsclide.evalSelection",
        "key": "ctrl+alt+shift+r",
        "when": "editorLangId == commonlisp && editorHasSelection"
      },
      {
        "command": "vsclide.openRepl",
        "key": "ctrl+alt+l",
        "when": "editorLangId == commonlisp"
      },
      {
        "command": "vsclide.inspect",
        "key": "ctrl+alt+shift+i",
        "when": "editorLangId == commonlisp"
      },
      {
        "command": "vsclide.showDebugger",
        "key": "ctrl+alt+d",
        "when": "vsclide.debugging"
      },
      {
        "command": "vsclide.debugContinue",
        "key": "ctrl+alt+shift+c",
        "when": "vsclide.debugging"
      },
      {
        "command": "vsclide.debugAbort",
        "key": "ctrl+alt+shift+a",
        "when": "vsclide.debugging"
      },
      {
        "command": "vsclide.debugStepInto",
        "key": "ctrl+alt+shift+s",
        "when": "vsclide.debugging"
      },
      {
        "command": "vsclide.debugStepNext",
        "key": "ctrl+alt+shift+n",
        "when": "vsclide.debugging"
      },
      {
        "command": "vsclide.debugStepOut",
        "key": "ctrl+alt+shift+o",
        "when": "vsclide.debugging"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vsclide.evalTopLevelForm",
          "when": "editorLangId == commonlisp",
          "group": "vsclide@1"
        },
        {
          "command": "vsclide.evalSelection",
          "when": "editorLangId == commonlisp && editorHasSelection",
          "group": "vsclide@2"
        },
        {
          "command": "vsclide.inspect",
          "when": "editorLangId == commonlisp",
          "group": "vsclide@3"
        }
      ],
      "view/title": [
        {
          "command": "vsclide.newRepl",
          "when": "view == vsclide.mrepl",
          "group": "navigation@1"
        },
        {
          "command": "vsclide.clearRepl",
          "when": "view == vsclide.mrepl",
          "group": "navigation@2"
        },
        {
          "command": "vsclide.closeRepl",
          "when": "view == vsclide.mrepl",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "vsclide-panel",
          "title": "mREPL",
          "icon": "data/graphics/lisp-icon-sm.svg"
        }
      ]
    },
    "views": {
      "vsclide-panel": [
        {
          "type": "webview",
          "id": "vsclide.mrepl",
          "name": "mREPL"
        }
      ]
    },
    "grammars": [
      {
        "language": "commonlisp",
        "scopeName": "source.commonlisp",
        "path": "./data/syntax/commonlisp.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.block.commonlisp",
            "settings": {
              "foreground": "#707070"
            }
          },
          {
            "scope": "comment.line.semicolon.commonlisp",
            "settings": {
              "foreground": "#707070"
            }
          },
          {
            "scope": "constant.character.commonlisp",
            "settings": {
              "foreground": "#e8b068"
            }
          },
          {
            "scope": "constant.character.escape.commonlisp",
            "settings": {
              "foreground": "#e8b068"
            }
          },
          {
            "scope": "constant.numeric.commonlisp",
            "settings": {
              "foreground": "#e8b068"
            }
          },
          {
            "scope": "constant.numeric.radix.commonlisp",
            "settings": {
              "foreground": "#e8b068"
            }
          },
          {
            "scope": "constant.other.keyword.commonlisp",
            "settings": {
              "foreground": "#b8d0f8"
            }
          },
          {
            "scope": "constant.other.uninterned.commonlisp",
            "settings": {
              "foreground": "#b0c8f0"
            }
          },
          {
            "scope": "entity.name.function.commonlisp",
            "settings": {
              "foreground": "#80a8c8"
            }
          },
          {
            "scope": "entity.name.namespace.commonlisp",
            "settings": {
              "foreground": "#b8d0f8"
            }
          },
          {
            "scope": "entity.name.namespace.defined.commonlisp",
            "settings": {
              "foreground": "#80a8c8"
            }
          },
          {
            "scope": "entity.name.namespace.defined.keyword.commonlisp",
            "settings": {
              "foreground": "#f8d078"
            }
          },
          {
            "scope": "entity.name.namespace.defined.uninterned.commonlisp",
            "settings": {
              "foreground": "#80a8c8"
            }
          },
          {
            "scope": "entity.name.type.commonlisp",
            "settings": {
              "foreground": "#80a8c8"
            }
          },
          {
            "scope": "entity.name.variable.commonlisp",
            "settings": {
              "foreground": "#80a8c8"
            }
          },
          {
            "scope": "keyword.control.commonlisp",
            "settings": {
              "foreground": "#e0a8e8"
            }
          },
          {
            "scope": "keyword.control.conditional.commonlisp",
            "settings": {
              "foreground": "#e0a8e8"
            }
          },
          {
            "scope": "keyword.operator.commonlisp",
            "settings": {
              "foreground": "#b0b0b0"
            }
          },
          {
            "scope": "keyword.operator.function.commonlisp",
            "settings": {
              "foreground": "#b0b0b0"
            }
          },
          {
            "scope": "keyword.operator.quote.commonlisp",
            "settings": {
              "foreground": "#b0b0b0"
            }
          },
          {
            "scope": "storage.modifier.lambda-list.commonlisp",
            "settings": {
              "foreground": "#e8b068"
            }
          },
          {
            "scope": "storage.type.class.commonlisp",
            "settings": {
              "foreground": "#e0a8e8"
            }
          },
          {
            "scope": "storage.type.commonlisp",
            "settings": {
              "foreground": "#e0a8e8"
            }
          },
          {
            "scope": "storage.type.function.commonlisp",
            "settings": {
              "foreground": "#e0a8e8"
            }
          },
          {
            "scope": "string.quoted.double.commonlisp",
            "settings": {
              "foreground": "#b0c870"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit -p ./code/jekyl && tsc --noEmit -p ./code/jekyl/webview",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "bundle": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package",
    "test": "node esbuild.js --tests && node --test out/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
