// Type-checks code/jekyl except webview, which has its own tsconfig
// (DOM library). esbuild bundles
// code/jekyl/extension.ts into out/extension.js, which package.json
// "main" (./out/extension.js) loads.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "rootDir": ".",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "tests", "webview"]
}
